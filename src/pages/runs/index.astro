---
import OperatingRunIndexPage from "../../components/OperatingRunIndexPage";
import { loadPortfolioData } from "../../lib/portfolioData";
import "../../styles/global.css";

const portfolioData = loadPortfolioData();
const canonicalUrl = `${portfolioData.publicUrl}runs/`;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const faviconUrl = `${baseUrl}favicon-cn.svg`;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="WineChord Invest full-cycle operating run history. Delayed personal research journal. Not investment advice."
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>Operating Runs | WineChord Invest</title>
  </head>
  <body>
    <OperatingRunIndexPage
      client:idle
      publicUrl={portfolioData.publicUrl}
      repositoryUrl={portfolioData.repositoryUrl}
      runs={portfolioData.operatingRuns}
    />
  </body>
</html>
