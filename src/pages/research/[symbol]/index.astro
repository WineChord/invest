---
import ResearchStockPage from "../../../components/ResearchStockPage";
import { loadPortfolioData } from "../../../lib/portfolioData";
import "../../../styles/global.css";

export function getStaticPaths() {
  const data = loadPortfolioData();
  return data.watchlist.map((item) => ({
    params: {
      symbol: item.symbol.toLowerCase(),
    },
    props: {
      item,
      publicUrl: data.publicUrl,
      repositoryUrl: data.repositoryUrl,
    },
  }));
}

const { item, publicUrl, repositoryUrl } = Astro.props;
const canonicalUrl = `${publicUrl}research/${item.symbol.toLowerCase()}/`;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const faviconUrl = `${baseUrl}favicon-cn.svg`;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`${item.symbol} research brief for WineChord Invest.`}
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>{item.symbol} Research | WineChord Invest</title>
  </head>
  <body>
    <ResearchStockPage
      client:load
      item={item}
      publicUrl={publicUrl}
      repositoryUrl={repositoryUrl}
    />
  </body>
</html>
