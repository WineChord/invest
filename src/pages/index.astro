---
import InvestDashboard from "../components/InvestDashboard";
import { loadPortfolioData } from "../lib/portfolioData";
import "../styles/global.css";

const portfolioData = loadPortfolioData();
const canonicalUrl = "https://www.wineandchord.com/invest/";
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const faviconUrl = `${baseUrl}favicon-cn.svg`;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="WineChord long-term satellite investment dashboard." />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>WineChord Invest</title>
  </head>
  <body>
    <InvestDashboard client:load data={portfolioData} />
  </body>
</html>
